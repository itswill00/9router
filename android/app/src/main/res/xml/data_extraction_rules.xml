<?xml version="1.0" encoding="utf-8"?>
<!--
  The state file contains chat transcripts and account metadata. Credentials
  are Keystore-bound and cannot be restored on another device, so do not copy
  any of it through cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
